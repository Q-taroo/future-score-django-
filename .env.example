# Copy this file to .env and fill in real values for your environment.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
APP_URL=http://localhost:8000
NOTE_TUTORIAL_URL=

# Email verification (Resend)
# Enable only after the domain is verified and both values are configured.
EMAIL_VERIFICATION_ENABLED=False
EMAIL_VERIFICATION_MAX_AGE=86400
RESEND_API_KEY=
RESEND_FROM_EMAIL=FUTURE SCORE <verify@example.com>

# Database (PostgreSQL)
DB_NAME=futurescore
DB_USER=futurescore
DB_PASSWORD=futurescore
DB_HOST=localhost
DB_PORT=5432

# AI Prediction Provider — one of: MOCK, OPENAI, ANTHROPIC, GOOGLE
# Falls back to MOCK automatically if the selected provider's API key is
# missing, so the app always runs without any external key.
AI_PROVIDER=MOCK
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Only needed in production (DJANGO_DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=3600
